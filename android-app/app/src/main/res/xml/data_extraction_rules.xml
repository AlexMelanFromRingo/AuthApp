<?xml version="1.0" encoding="utf-8"?>
<!-- Секрети ніколи не потрапляють у хмарні бекапи та перенесення між пристроями -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
